---
const {
  PUBLIC_GISCUS_REPO,
  PUBLIC_GISCUS_REPO_ID,
  PUBLIC_GISCUS_CATEGORY,
  PUBLIC_GISCUS_CATEGORY_ID,
} = import.meta.env;

const isGiscusConfigured = [
  PUBLIC_GISCUS_REPO,
  PUBLIC_GISCUS_REPO_ID,
  PUBLIC_GISCUS_CATEGORY,
  PUBLIC_GISCUS_CATEGORY_ID,
].every(Boolean);
---

{
  isGiscusConfigured && (
    <>
      <div class="giscus" />
      {/* Built at runtime so the starting theme follows the site's toggle, not the OS */}
      <script
        is:inline
        data-astro-rerun
        define:vars={{
          repo: PUBLIC_GISCUS_REPO,
          repoId: PUBLIC_GISCUS_REPO_ID,
          category: PUBLIC_GISCUS_CATEGORY,
          categoryId: PUBLIC_GISCUS_CATEGORY_ID,
        }}
      >
        const isDark = document.documentElement.classList.contains("dark");
        const giscus = document.createElement("script");
        giscus.src = "https://giscus.app/client.js";
        giscus.crossOrigin = "anonymous";
        giscus.async = true;
        Object.assign(giscus.dataset, {
          repo,
          repoId,
          category,
          categoryId,
          mapping: "pathname",
          strict: "0",
          reactionsEnabled: "1",
          emitMetadata: "0",
          inputPosition: "bottom",
          theme: isDark ? "noborder_dark" : "noborder_light",
          lang: "en",
          loading: "lazy",
        });
        document.currentScript.after(giscus);
      </script>
    </>
  )
}
