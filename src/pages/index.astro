---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS, AVATAR_SEED } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
// ponytail: blobatar() only returns static SVG, so this builds the animated
// markup from blobatar/internal the same way @blobatar/svelte does. That entry
// point can change between majors, which is why blobatar is pinned exactly.
import { _parts } from "blobatar/internal";
import "blobatar/motion.css";
import "blobatar/gaze.css";

const avatarTitle = "Mac's avatar";
const avatar = _parts(AVATAR_SEED, { animate: "always", title: avatarTitle });
const avatarStyle = Object.entries(avatar.vars ?? {})
  .map(([key, value]) => `${key}:${value}`)
  .concat("--mo-track-travel:3px")
  .join(";");

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="flex items-center justify-center gap-3 font-semibold text-black dark:text-white">
        <svg
          id="avatar"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 100"
          class="size-28"
          role="img"
          style={avatarStyle}
        >
          <title>{avatarTitle}</title>
          {avatar.bg && <path d={avatar.bg.d} fill={avatar.bg.fill} />}
          <g class={avatar.cls} set:html={avatar.inner} />
        </svg>
      </h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <span>
              <p>
                Hey, I'm Mac — an infrastructure and DevOps engineer with a background
                in security, based in Baltimore. By day I wrangle Ansible playbooks and
                CI pipelines; by night I break things in my home lab.
              </p>
              <p>
                This blog is where I word-dump about whatever has my attention that
                week: infrastructure-as-code, security, self-hosting, and the
                occasional detour into something with no technical value at all.
              </p>
            </span>
            <span class="animate">
              <p>
                Fair warning: this place is a bit of an echo chamber. Population: me.
                Every post is reviewed, approved, and enthusiastically agreed with by
                its author. If you want to break the cycle, that's what the
                comments are for.
              </p>
              <p>
                You can find my code on
                <Link href="https://github.com/mackiser" external>GitHub</Link>
                and my questionable movie opinions on
                <Link href="https://letterboxd.com/mackiser/" external>Letterboxd</Link>.
              </p>
            </span>
          </article>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Latest posts
            </h2>
            <Link href="/blog"> See all posts </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Recent projects
            </h2>
            <Link href="/projects"> See all projects </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>

<script>
  import { gaze } from "blobatar/gaze";

  // The ClientRouter swaps pages without a reload, so attach on every load
  // and detach before leaving
  document.addEventListener("astro:page-load", () => {
    const avatar = document.querySelector<SVGSVGElement>("#avatar");
    if (!avatar) return;
    const eyes = gaze(avatar, { target: "pointer" });
    document.addEventListener("astro:before-swap", () => eyes.stop(), {
      once: true,
    });
  });
</script>
