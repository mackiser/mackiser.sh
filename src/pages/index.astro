---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS, AVATAR_SEED } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
// ponytail: blobatar() only returns static SVG, so this builds the animated
// markup from blobatar/internal the same way @blobatar/svelte does. That entry
// point can change between majors, which is why blobatar is pinned exactly.
import { _parts } from "blobatar/internal";
import { mad } from "blobatar/expression";
import "blobatar/motion.css";
import "blobatar/gaze.css";

const avatarTitle = "Mac's avatar";
const avatar = _parts(AVATAR_SEED, { animate: "always", title: avatarTitle });
const avatarVars = avatar.vars ?? {};
const avatarStyle = Object.entries(avatarVars)
  .map(([key, value]) => `${key}:${value}`)
  .concat("--mo-track-travel:3px")
  .join(";");

// The mad pose only differs in custom properties (plus the mo-expr class), so
// the click handler swaps just those in and back out
const madVars = _parts(AVATAR_SEED, { animate: "always", expression: mad }).vars ?? {};
const madChanges = Object.fromEntries(
  Object.entries(madVars).filter(([key, value]) => avatarVars[key] !== value),
);

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="flex items-center justify-center gap-3 font-semibold text-black dark:text-white">
        <svg
          id="avatar"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 100"
          class="size-28"
          role="img"
          style={avatarStyle}
          data-mad={JSON.stringify(madChanges)}
          data-idle={JSON.stringify(avatarVars)}
        >
          <title>{avatarTitle}</title>
          {avatar.bg && <path d={avatar.bg.d} fill={avatar.bg.fill} />}
          <g class={avatar.cls} set:html={avatar.inner} />
        </svg>
      </h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <span>
              <p>
                Hi, I'm Mac, an infrastructure and DevOps engineer with a security background, based in Baltimore. My day job is mostly Ansible playbooks and CI pipelines. After hours I break things in my home lab.
              </p>
              <p>
                This is where I word-dump about whatever's got my attention, whether that's infrastructure-as-code, security, self-hosting or the occasional detour into something with zero technical value.
              </p>
            </span>
            <span class="animate">
              <p>
                Fair warning, this place is an echo chamber. Population: me. Every post is reviewed, approved and enthusiastically agreed with by its only author. Want to break the cycle? That's what the comments are for.
              </p>
              <p>
                You can find my code on
                <Link href="https://github.com/mackiser" external>GitHub</Link>
                and my movie opinions on
                <Link href="https://letterboxd.com/mackiser/" external>Letterboxd</Link>.
              </p>
            </span>
          </article>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Latest posts
            </h2>
            <Link href="/blog"> See all posts </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Recent projects
            </h2>
            <Link href="/projects"> See all projects </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>

<script>
  import { gaze } from "blobatar/gaze";

  // The ClientRouter swaps pages without a reload, so attach on every load
  // and detach before leaving
  document.addEventListener("astro:page-load", () => {
    const avatar = document.querySelector<SVGSVGElement>("#avatar");
    if (!avatar) return;
    const eyes = gaze(avatar, { target: "pointer" });
    document.addEventListener("astro:before-swap", () => eyes.stop(), {
      once: true,
    });

    // Clicking makes it mad for a moment, then it calms back down
    const root = avatar.querySelector(".mo-root")!;
    const madVars: Record<string, string> = JSON.parse(avatar.dataset.mad!);
    const idleVars: Record<string, string> = JSON.parse(avatar.dataset.idle!);
    let calmDown: number | undefined;
    avatar.addEventListener("click", () => {
      for (const [key, value] of Object.entries(madVars))
        avatar.style.setProperty(key, value);
      root.classList.add("mo-expr");
      clearTimeout(calmDown);
      calmDown = window.setTimeout(() => {
        for (const key of Object.keys(madVars)) {
          if (key in idleVars) avatar.style.setProperty(key, idleVars[key]);
          else avatar.style.removeProperty(key);
        }
        root.classList.remove("mo-expr");
      }, 1500);
    });
  });
</script>

<style>
  /* Keep the idle motion but drop blobatar's lift-and-grow on hover */
  #avatar :global(.mo-root:hover) {
    transform: none;
  }
</style>
